rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when someone is logged in.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    // Staff = logged in AND their email has a document in the "staff" collection.
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email.lower());
    }
    function isStaff() { return signedIn() && exists(staffPath()); }
    function isAdmin() { return isStaff() && get(staffPath()).data.role == 'admin'; }

    // A person may read only their own staff entry. Nobody can write it from the app:
    // the owner edits it in the Firebase Console.
    match /staff/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // School records: staff can read, only admins can write (spreadsheet upload).
    match /{collection}/{docId} {
      allow read:  if collection in ['students', 'meta', 'invoice', 'stock'] && isStaff();
      allow write: if collection in ['students', 'meta', 'invoice', 'stock'] && isAdmin();
    }

    // Everything else is blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
